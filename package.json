  "private": true,
  "description": "Sales and customer dashboard for a multi-channel e-commerce business, built on the marts of ec-analytics-platform.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
